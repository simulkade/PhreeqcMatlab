# PhreeqcMatlab + FVTool 2D reactive-transport control file.
# Pairs with reactive_transport_2d_input.pqc (20 cells = Nx*Ny).
ADVECTION
    Coordinate      Cartesian
    Dimension       2
    Nx              5
    Ny              4
    Lx              0.05
    Ly              0.04
    shifts          12
    time_step       1.0
    initial_saturation 1.0
    initial_porosity   1.0
    representative_volume 1.0
END

PhreeqcMatlab
    threads   2
    component_water    0
    screen_messages    0
    error_handler_mode 1
    use_solution_density_volume 0
    units_solution    2
    units_exchange    1
    time_conversion   1.0
    data_base     phreeqc.dat
END
